{
  "name": "troveofgems_archive",
  "version": "1.0.0",
  "description": "Trove of Gems Archive and Knowledge Base",
  "main": "index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "client": "concurrently \"cd ./client && NODE_ENV=production npm run serve\"",
    "devclient": "concurrently \"cd ./client && NODE_ENV=development npm run start\"",
    "server": "concurrently \"cd ./server && NODE_ENV=production node dist/main.js\"",
    "devserver": "concurrently \"cd ./server && NODE_ENV=development nodemon main.ts\"",
    "prod": "concurrently \"npm:server\" \"npm:client\"",
    "dev": "concurrently \"npm:devserver\" \"npm:devclient\""
  },
  "private": true,
  "dependencies": {
    "concurrently": "^8.2.2",
    "connect-mongodb-session": "^5.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "mongoose": "^8.6.0",
    "rate-limiter-flexible": "^5.0.3",
    "serve-favicon": "^2.5.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/connect-mongodb-session": "^2.4.7",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/hpp": "^0.2.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.1",
    "@types/serve-favicon": "^2.5.7",
    "@types/uuid": "^10.0.0",
    "chalk": "^5.3.0",
    "express-session": "^1.18.0",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
